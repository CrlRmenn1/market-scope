# Every environment variable the backend reads, with its default.
# All are optional for local development. Most are read in core/config.py.
# Never commit real values: .env is git-ignored.

# --- Database ---------------------------------------------------------------
# If DATABASE_URL is set (Render), it wins over the MARKETSCOPE_DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/marketscope_db
MARKETSCOPE_DB_NAME=marketscope_db
MARKETSCOPE_DB_USER=postgres
MARKETSCOPE_DB_PASSWORD=1234
MARKETSCOPE_DB_HOST=localhost
MARKETSCOPE_DB_PORT=5432
MARKETSCOPE_DB_CONNECT_TIMEOUT=8
MARKETSCOPE_DB_OPTIONS=-c statement_timeout=10000
# Used only while creating tables at startup.
MARKETSCOPE_DB_STARTUP_OPTIONS=-c statement_timeout=0

# --- Server (main.py) -------------------------------------------------------
MARKETSCOPE_HOST=0.0.0.0
# PORT (set by Render) wins over MARKETSCOPE_PORT.
MARKETSCOPE_PORT=8000
# Comma-separated list. Empty means allow all origins.
MARKETSCOPE_ALLOWED_ORIGINS=

# --- Admin ------------------------------------------------------------------
# Change these in production: the defaults are public.
MARKETSCOPE_ADMIN_EMAIL=admin@marketscope.local
MARKETSCOPE_ADMIN_PASSWORD=admin123
MARKETSCOPE_ADMIN_TOKEN=marketscope-admin-local-token

# --- Password reset ---------------------------------------------------------
MARKETSCOPE_RESET_CODE_TTL_MINUTES=10
# Currently has no effect (routers/auth.py reads it but does nothing with it).
MARKETSCOPE_RESET_CODE_DEV_MODE=false

# --- Email (SMTP). Without SMTP_HOST, reset codes are printed to the console.
MARKETSCOPE_SMTP_HOST=
MARKETSCOPE_SMTP_PORT=587
MARKETSCOPE_SMTP_USERNAME=
MARKETSCOPE_SMTP_PASSWORD=
MARKETSCOPE_SMTP_FROM_EMAIL=
MARKETSCOPE_SMTP_FROM_NAME=MarketScope
MARKETSCOPE_SMTP_USE_TLS=true
MARKETSCOPE_SMTP_USE_SSL=false

# --- Citywide trend scan cache (seconds) ------------------------------------
MARKETSCOPE_TREND_SCAN_CACHE_TTL_SECONDS=21600
MARKETSCOPE_TREND_SCAN_CACHE_MAX_STALE_SECONDS=86400
MARKETSCOPE_TREND_SCAN_AUTO_REFRESH_INTERVAL_SECONDS=7200

# --- Reports ----------------------------------------------------------------
# Optional. Without it, report narratives use the built-in template text.
# Read in services/reporting.py.
GEMINI_API_KEY=
